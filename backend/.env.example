# ============================================================================
# ARIES-Voice backend environment
# Copy to backend/.env and fill in. Never commit the filled-in file.
# ============================================================================

APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# --- LiveKit (REQUIRED, Phase 1) -------------------------------------------
# Get these from https://cloud.livekit.io -> your project -> Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=aries-interviewer

# --- Fully local AI (REQUIRED, no API key or billing) ----------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_FAST_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Must match backend/db/models.py.
OLLAMA_EMBEDDING_DIMENSIONS=768
LOCAL_AI_TIMEOUT_SECONDS=120

# Speaches serves Faster-Whisper STT and Kokoro TTS locally.
SPEECH_BASE_URL=http://localhost:8001/v1
SPEECH_API_KEY=local-not-needed
SPEECH_STT_MODEL=Systran/faster-distil-whisper-small.en
SPEECH_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
SPEECH_TTS_VOICE=af_heart

# Random server-side value used to sign transcript/report access links.
SESSION_SIGNING_SECRET=replace-with-a-long-random-value

# --- Postgres (REQUIRED, Phase 2) ------------------------------------------
# Matches the credentials in docker-compose.yml at the repo root.
DATABASE_URL=postgresql+asyncpg://aries:aries@localhost:5432/aries
# Set to false to run the voice loop with no database attached (Phase 1 mode).
PERSISTENCE_ENABLED=true

# --- Langfuse tracing (OPTIONAL) -------------------------------------------
# https://cloud.langfuse.com -> project -> Settings -> API keys
# Leave blank to disable tracing entirely; nothing else breaks.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
